@model BookViewModel
@{
    ViewData["Title"] = "Новая книга";
}

<h1 class="h3">Новая книга</h1>

<form asp-action="Create" method="post">
    <partial name="_BookForm" model="Model" />
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-link">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_TocEditorScripts" />
}