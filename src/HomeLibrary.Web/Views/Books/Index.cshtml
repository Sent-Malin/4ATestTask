@model IReadOnlyList<BookListItem>
@{
    ViewData["Title"] = "Библиотека";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Домашняя библиотека</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col">
        <input name="search" value="@search" class="form-control"
               placeholder="Поиск по названию, автору, оглавлению" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Найти</button>
        <a asp-action="Index" class="btn btn-link">Сбросить</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">Ничего не найдено.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Название</th>
                <th>Автор</th>
                <th>Год</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublishYear</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Открыть</a>
                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                        <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Удалить книгу?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}